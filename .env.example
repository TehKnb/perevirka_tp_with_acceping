# Відправка результатів у Telegram (api/submit.js).
# Скопіюйте цей файл у .env.local і заповніть. На Railway ті самі змінні задаються
# у Variables. Справжній токен у git не комітимо.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# Кнопки «Підтвердити» / «Відхилити» під заявкою (api/telegram.js).
# Адреса вебхука — домен цього сайту + /api/telegram; server.js реєструє її в Telegram під час запуску.
# Секрет — будь-який випадковий рядок (літери, цифри, _ і -), Telegram надсилатиме його з кожним оновленням.
# Локально вебхук не працює (Telegram не достукається до localhost), тож тут можна лишити порожніми.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
